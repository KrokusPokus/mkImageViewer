/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

POPUPMENU MENU
BEGIN
    POPUP "PopupMenu"
    BEGIN
        MENUITEM "Next image",                      IDM_NEXT
        MENUITEM "Previous image",                  IDM_PREV
        POPUP "Current View"
        BEGIN
            MENUITEM "Rotate +90",                  IDM_ROTATE_90
            MENUITEM "Rotate -90",                  IDM_ROTATE_270
            MENUITEM SEPARATOR
            MENUITEM "Mirror horizontally",         IDM_MIRROR_H
            MENUITEM "Mirror vertically",           IDM_MIRROR_V
            MENUITEM SEPARATOR
            MENUITEM "Fit to window",               IDM_FIT_TO_SCREEN
            MENUITEM "Fill with crop",              IDM_FILL_WITH_CROP
            MENUITEM SEPARATOR
            MENUITEM "400 %",                       IDM_ZOOM_400
            MENUITEM "200 %",                       IDM_ZOOM_200
            MENUITEM "100 %",                       IDM_ZOOM_100
            MENUITEM "50 %",                        IDM_ZOOM_50
            MENUITEM "25 %",                        IDM_ZOOM_25
        END
        POPUP "Window"
        BEGIN
            MENUITEM "Full screen mode",            IDM_FULL_SCREEN_MODE
            MENUITEM "Fit window to image",         IDM_FIT_WINDOW_TO_IMAGE
            MENUITEM "Hide window title bar",       IDM_HIDE_TITLE_BAR
            MENUITEM "Set window always on top",    IDM_ALWAYS_ON_TOP

        END
        MENUITEM SEPARATOR
        POPUP "Play folder as slideshow/movie"
        BEGIN
            MENUITEM "Pause Slideshow/Movie\t0xff", IDM_STOP_MOVIE
            MENUITEM SEPARATOR
            MENUITEM "Slideshow",                   IDM_SLIDESHOW_START
            MENUITEM "Waiting time\t1 sec",         IDM_SLIDESHOW_1
            MENUITEM "Waiting time\t2 sec",         IDM_SLIDESHOW_2
            MENUITEM "Waiting time\t3 sec",         IDM_SLIDESHOW_3
            MENUITEM "Waiting time\t4 sec",         IDM_SLIDESHOW_4
            MENUITEM "Waiting time\t5 sec",         IDM_SLIDESHOW_5
            MENUITEM "Waiting time\t7 sec",         IDM_SLIDESHOW_7
            MENUITEM "Waiting time\t10 sec",        IDM_SLIDESHOW_10
            MENUITEM "Waiting time\t20 sec",        IDM_SLIDESHOW_20
            POPUP "Transition Effect"
            BEGIN
                MENUITEM "None",                        IDM_EFFECT_NONE
                MENUITEM SEPARATOR
                MENUITEM "Blend",                       IDM_EFFECT_BLEND
                MENUITEM SEPARATOR
                MENUITEM "Slide from right",            IDM_EFFECT_SLIDE_RL
                MENUITEM "Slide from left",             IDM_EFFECT_SLIDE_LR
                MENUITEM "Slide from top",              IDM_EFFECT_SLIDE_TB
                MENUITEM "Slide from bottom",           IDM_EFFECT_SLIDE_BT
                MENUITEM SEPARATOR
                MENUITEM "Roll from right",             IDM_EFFECT_ROLL_RL
                MENUITEM "Roll from left",              IDM_EFFECT_ROLL_LR
                MENUITEM "Roll from top",               IDM_EFFECT_ROLL_TB
                MENUITEM "Roll from bottom",            IDM_EFFECT_ROLL_BT
                MENUITEM SEPARATOR
                MENUITEM "Scroll from right",           IDM_EFFECT_SCROLL_RL
                MENUITEM "Scroll from left",            IDM_EFFECT_SCROLL_LR
                MENUITEM "Scroll from top",             IDM_EFFECT_SCROLL_TB
                MENUITEM "Scroll from bottom",          IDM_EFFECT_SCROLL_BT
            END
            POPUP "Transition Speed"
            BEGIN
                MENUITEM "Very fast",                   IDM_EFFECTTIME_VERY_FAST
                MENUITEM "Fast",                        IDM_EFFECTTIME_FAST
                MENUITEM "Normal",                      IDM_EFFECTTIME_NORMAL
                MENUITEM "Slow",                        IDM_EFFECTTIME_SLOW
                MENUITEM "Very slow",                   IDM_EFFECTTIME_VERY_SLOW
            END
            MENUITEM SEPARATOR
            MENUITEM "Movie",                           IDM_MOVIE_START_FPS
            MENUITEM "Playback speed\t5 fps",           IDM_MOVIE_5_FPS
            MENUITEM "Playback speed\t10 fps",          IDM_MOVIE_10_FPS
            MENUITEM "Playback speed\t15 fps",          IDM_MOVIE_15_FPS
            MENUITEM "Playback speed\t20 fps",          IDM_MOVIE_20_FPS
            MENUITEM "Playback speed\t25 fps",          IDM_MOVIE_25_FPS
            MENUITEM "Playback speed\t30 fps",          IDM_MOVIE_30_FPS
            MENUITEM "Playback speed\t50 fps",          IDM_MOVIE_50_FPS
            MENUITEM "Playback speed\t60 fps",          IDM_MOVIE_60_FPS
            MENUITEM "Playback speed\t100 fps",         IDM_MOVIE_100_FPS
        END
        MENUITEM SEPARATOR
        MENUITEM "Reload image",                    IDM_RELOAD_FULL
        MENUITEM "Edit image in default editor",       IDM_OPEN_DEFAULT_EDITOR
        MENUITEM "Copy original image content to clipboard", IDM_COPY_FULL
        MENUITEM "Copy file path to clipboard",              IDM_COPY_PATH
        MENUITEM "Cut file to clipboard",           IDM_CUT_FILE
        MENUITEM "Open containing folder in Explorer", IDM_EXPLORE
        MENUITEM SEPARATOR
        POPUP "Folder Mode"
        BEGIN
            MENUITEM "Loop folder",                 IDM_LOOP_FOLDER
            MENUITEM "Loop recursively",            IDM_LOOP_RECURSIVELY
            MENUITEM "Loop siblings",               IDM_LOOP_SIBLINGS
        END
        POPUP "Sort Order"
        BEGIN
            MENUITEM "File name",                   IDM_SORT_NAME
            MENUITEM "Modification date",           IDM_SORT_MOD_DATE
            MENUITEM "File size",                   IDM_SORT_SIZE
            MENUITEM "Random",                      IDM_SORT_RANDOM
            MENUITEM SEPARATOR
            MENUITEM "Ascending",                   IDM_SORT_ASCENDING
            MENUITEM "Descending",                  IDM_SORT_DESCENDING
        END
        POPUP "Auto Zoom Mode"
        BEGIN
            MENUITEM "None",                        IDM_AUTO_ZOOM_NONE
            MENUITEM "Fit to window",               IDM_AUTO_ZOOM_FIT
            MENUITEM "Fill with crop",              IDM_AUTO_ZOOM_FILL
            MENUITEM "Fit to window (never upsize)",     IDM_AUTO_ZOOM_FIT_NO_ZOOM
            MENUITEM "Fill with crop (never upsize)",    IDM_AUTO_ZOOM_FILL_NO_ZOOM
            MENUITEM "Book Mode",                   IDM_AUTO_ZOOM_BOOK_MODE
        END
        MENUITEM "Auto Contrast",             IDM_AUTO_CORRECTION
        MENUITEM SEPARATOR
        MENUITEM "Edit Settings",       IDM_EDIT_USER_CONFIG
		MENUITEM "Settings Dialog",       IDM_SETTINGS_DIALOG
        MENUITEM SEPARATOR
        MENUITEM "Exit\t0xffff",                IDM_EXIT
    END
END


