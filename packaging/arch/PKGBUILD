# Maintainer: KrokusPokus <E-Mail-Adresse eintragen>
#
# Entwurf fuer das AUR-Paket mkimageviewer-git (baut den aktuellen Stand von master).
# Vor dem Hochladen im AUR-Repository: makepkg --printsrcinfo > .SRCINFO
#
# Die CMakeLists baut mit -march=native: das Paket laeuft nur auf CPUs mit denselben Befehlssaetzen wie
# die des Rechners, auf dem es gebaut wurde. Daher auf dem Zielrechner selbst bauen.

pkgname=mkimageviewer-git
_pkgname=mkImageViewer
pkgver=r0.0000000
pkgrel=1
pkgdesc='Minimalist Qt6 image viewer based on JPEGView'
arch=('x86_64')
url='https://github.com/KrokusPokus/mkImageViewer'
license=('GPL-2.0-or-later')
depends=(
  'gcc-libs'
  'glibc'
  'lcms2'
  'libavif'
  'libheif'
  'libjxl'
  'qt6-base'
  'qt6-svg'   # SVG-Fenstericons
)
makedepends=(
  'cmake'
  'git'
  'qt6-tools'   # lupdate/lrelease fuer die Uebersetzungen
)
optdepends=(
  '7zip: CB7 and 7z archives'
  'kimageformats: more image formats through Qt'
  'qt6-imageformats: TIFF, ICNS and more image formats through Qt'
)
provides=('mkimageviewer')
conflicts=('mkimageviewer')
# libjpeg-turbo, libpng, zlib, libwebp und bit7z sind als statische Bibliotheken im Repository enthalten
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  # Release statt der bei Arch ueblichen None: die CMakeLists setzt NDEBUG nur fuer Release
  cmake -B build -S "$_pkgname" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_pkgname/LICENSE.txt" "$_pkgname/COPYING.txt"
}
